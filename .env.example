# =============================================================================
#  OpenSignage — optionale Einstellungen  /  optional settings
# =============================================================================
#
#  DIESE DATEI WIRD NICHT BENOETIGT. `docker compose up -d` laeuft ohne sie.
#  Kennwoerter erzeugt der Stapel beim ersten Start selbst.
#
#  THIS FILE IS NOT REQUIRED. `docker compose up -d` works without it.
#  Passwords are generated on first start.
#
#  Nutzung / usage:  cp .env.example .env   und nur die Zeilen setzen, die man braucht.
# =============================================================================

# --- Adresse / address -------------------------------------------------------
# Oeffentliche Adresse des CMS. Steht in Einladungslinks und im Kiosk-Paket.
# Public address of the CMS. Used in invitation links and the kiosk package.
#PUBLIC_URL=https://signage.example.local

# Name im selbst erzeugten TLS-Zertifikat. Nur wirksam, solange kein eigenes
# Zertifikat im Datentraeger "certs" liegt.
# Common name for the self-generated certificate; ignored once you drop in your own.
#PUBLIC_HOSTNAME=signage.example.local

# Ports auf dem Wirtssystem, falls 80/443 schon belegt sind.
# Host ports, in case 80/443 are already taken.
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Beschriftung / branding -------------------------------------------------
# Anzeigename der Anlage in Oberflaeche, Player und Anleitung. Leer = "OpenSignage".
# Display name shown in the UI, the player and the guide. Empty = "OpenSignage".
#BRAND_NAME=Beispiel-Signage

# Technischer Kurzname: Ordner und Aufgabennamen auf den Windows-Anzeigegeraeten
# (C:\ProgramData\<Kurzname>, geplante Aufgaben, Kiosk-Paket). Nur A-Z, a-z, 0-9.
#
# ACHTUNG: Nachtraeglich aendern bricht BEREITS INSTALLIERTE Geraete - sie suchen
# ihre Dateien weiter unter dem alten Namen. Vor dem ersten Ausrollen festlegen.
# WARNING: changing this later breaks devices that are already installed.
#BRAND_SLUG=OpenSignage

# --- Erster Administrator / first administrator ------------------------------
# Leer lassen: es wird "admin" mit einem Zufallskennwort angelegt, das EINMALIG
# im Protokoll steht (docker compose logs cms).
# Leave empty: user "admin" is created with a random password, printed once to the log.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=

# --- Datenbank / database ----------------------------------------------------
# Das Kennwort steht bewusst NICHT hier, sondern im Datentraeger "secrets".
# Diese beiden Namen nur aendern, bevor die Datenbank das erste Mal angelegt wird.
# The password deliberately lives in the "secrets" volume, not here.
#POSTGRES_USER=opensignage
#POSTGRES_DB=opensignage

# Vollstaendige Verbindungszeichenkette - nur fuer eine EXTERNE Datenbank.
# Ist sie gesetzt, werden die Bausteine oben ignoriert.
# Only for an external database; overrides the parts above.
#DATABASE_URL=postgres://user:pass@dbhost:5432/opensignage

# --- Active Directory (optional) ---------------------------------------------
# Leer lassen = ausschliesslich lokale Benutzerkonten.
# Leave empty = local user accounts only.
# Mehrere Domaenencontroller mit Semikolon trennen (der erste erreichbare gewinnt).
# Separate multiple domain controllers with a semicolon.
#AD_DCS=dc01.example.com;dc02.example.com
#AD_PORT=636
#AD_USE_SSL=true
#AD_UPN_SUFFIX=example.com
# Auf "true" setzen, sobald der Domaenencontroller ein Zertifikat vorweist, dem der
# Server vertraut. Set to "true" once the DC presents a certificate the server trusts.
#AD_TLS_REJECT_UNAUTHORIZED=false

# --- Icinga 2 (optional) -----------------------------------------------------
# Fuer die Monitoring-Kachel. Leer lassen = Kachel meldet "nicht eingerichtet".
# For the monitoring widget. Leave empty = widget reports "not configured".
#
# Bitte einen eigenen API-Benutzer mit NUR Leserechten anlegen, nicht den Root-Zugang:
# Please create a dedicated API user with READ-ONLY permissions, not the root account:
#
#   object ApiUser "opensignage" {
#     password = "<Zufallskennwort>"
#     permissions = [ "objects/query/Host", "objects/query/Service",
#                     "objects/query/HostGroup", "objects/query/ServiceGroup", "status/query" ]
#   }
#
# Port 5665 ist die API. Icinga Web 2 (443) ist etwas anderes und funktioniert hier nicht.
# Port 5665 is the API. Icinga Web 2 (443) is a different thing and will not work here.
#ICINGA_URL=https://icinga.example.local:5665
#ICINGA_API_USER=opensignage
#ICINGA_API_PASSWORD=
#ICINGA_TLS_REJECT_UNAUTHORIZED=false
