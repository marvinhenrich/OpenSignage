[Set:Product]
AddMeter -1
; Kiosk-Einrichtung ueberwiegend mit NATIVEN Windows-Tools (certutil/net/reg) — diese werden von
; EgoSecure praktisch nie blockiert (anders als powershell.exe als Kind des Setup-Prozesses).
; Der mkdir-Marker zeigt, ob die Engine [Set:Product] ueberhaupt ausfuehrt.
Call cmd.exe /c mkdir "C:\ProgramData\OpenSignage"
; 1) CMS-Zertifikat in Trusted Root
Call certutil.exe -addstore -f Root "%SRC%\opensignage-ca.crt"
; 2) Kiosk-Konto anlegen (Passwort <=14 Zeichen -> net user fragt NICHT interaktiv nach) + zur Users-Gruppe
; Kiosk-Konto und Auto-Logon macht das PowerShell-Skript weiter unten - MIT ZUFALLSPASSWORT.
; Hier stand frueher ein festes Passwort im Klartext; diese Datei ist ueber die Anleitung
; herunterladbar, damit kannte jeder im Netz das Kiosk-Konto aller Geraete.
; 3) Auto-Logon (Winlogon)
Call reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v AutoAdminLogon /t REG_SZ /d 1 /f
Call reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v DefaultUserName /t REG_SZ /d kiosk /f
; DefaultPassword setzt das PowerShell-Skript (Zufallswert, steht in keiner Datei).
; 3b) Edge-Kiosk saeubern per Richtlinie: Uebersetzen-Popup + Erststart-Seite AUS (bombensicher, nicht nur Flag)
Call reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v TranslateEnabled /t REG_DWORD /d 0 /f
Call reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v HideFirstRunExperience /t REG_DWORD /d 1 /f
; 3c) Signage-Energieplan: NIEMALS schlafen/Display aus/sperren (sonst kommt nach Ruhezustand der Login,
;     weil Auto-Logon nur beim Boot greift). Nativ per powercfg -> ueberlebt Reboots.
Call powercfg.exe /change standby-timeout-ac 0
Call powercfg.exe /change standby-timeout-dc 0
Call powercfg.exe /change monitor-timeout-ac 0
Call powercfg.exe /change monitor-timeout-dc 0
Call powercfg.exe /change hibernate-timeout-ac 0
Call powercfg.exe /change hibernate-timeout-dc 0
Call powercfg.exe /change disk-timeout-ac 0
Call powercfg.exe /change disk-timeout-dc 0
Call powercfg.exe /setacvalueindex SCHEME_CURRENT SUB_NONE CONSOLELOCK 0
Call powercfg.exe /setdcvalueindex SCHEME_CURRENT SUB_NONE CONSOLELOCK 0
Call powercfg.exe /setactive SCHEME_CURRENT
; Sperrbildschirm ganz aus (kein Lock -> Sitzung bleibt aktiv)
Call reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Windows\Personalization" /v NoLockScreen /t REG_DWORD /d 1 /f
Call reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\Power" /v AwayModeEnabled /t REG_DWORD /d 0 /f
; 3d) WLAN HART AUS (Geraet haengt am LAN): WLAN-AutoConfig-Dienst deaktivieren (name-unabhaengig, dauerhaft)
;     + Adapter abschalten (DE/EN-Name). sc/reg -> kein interaktiver Prompt.
Call sc.exe stop Wlansvc
Call reg.exe add "HKLM\SYSTEM\CurrentControlSet\Services\Wlansvc" /v Start /t REG_DWORD /d 4 /f
Call netsh.exe interface set interface name="Wi-Fi" admin=disabled
Call netsh.exe interface set interface name="WLAN" admin=disabled
; 4) Assigned Access (braucht zwingend PowerShell/WMI). Skript ist idempotent, legt Konto ggf. erneut an
;    und protokolliert nach C:\ProgramData\OpenSignage\install.log (auch ohne Admin lesbar).
Call powershell.exe -ExecutionPolicy Bypass -NoProfile -File "%SRC%\Install-OpenSignageKiosk.ps1"

[Set:Uninstall]
-AddMeter -1
-Call powershell.exe -ExecutionPolicy Bypass -NoProfile -File "%SRC%\Uninstall-OpenSignageKiosk.ps1"

